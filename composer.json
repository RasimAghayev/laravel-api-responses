{
    "name": "rasimaghayev/laravel-api-responses",
    "description": "Laravel package providing shared API response classes extracted from Group B repos (atl_tech, AC-Task, blockchain-monitoring-api).",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rasim Aghayev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "13.35.0",
        "illuminate/support": "13.33.0",
        "symfony/http-foundation": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "RasimAghayev\\LaravelApiResponses\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RasimAghayev\\LaravelApiResponses\\LaravelApiResponsesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}